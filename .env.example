# CockroachDB Cloud connection string (from the Cloud Console "Connect" dialog)
DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full

# AWS
AWS_REGION=ap-south-1

# Provider routing. Bedrock is the primary path; the direct vendor APIs are a
# drop-in fallback (used for the recorded demo while this AWS account's Bedrock
# allowlisting was pending). Leave the model IDs blank to use each provider's
# default — see src/dejaops/config.py.
LLM_PROVIDER=bedrock        # bedrock | anthropic
EMBED_PROVIDER=bedrock      # bedrock | voyage
LLM_MODEL_ID=
EMBED_MODEL_ID=
EMBED_DIM=1024

# Only needed when the matching provider is selected above
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Offline development (no AWS needed): deterministic embeddings + canned LLM
FAKE_EMBEDDINGS=0
FAKE_LLM=0

# Demo hardening for the public URL
DEMO_TOKEN=
RATE_LIMIT_PER_MINUTE=30
